# Development environment example
# Copy to .env (or .env.development) for local/dev use.

# Application
DATABASE_URL=postgresql://lis_user:lis_password@localhost:5432/lis_db
SESSION_SECRET=change-me-in-production-use-a-long-random-string
NODE_ENV=development
PORT=3001

# Storage paths (relative to apps/backend)
STORAGE_PATH=./storage

# Template source directory for dev-mode interactive template editing.
# Set this to write template JSON edits back to source files (not the DB).
# Path is relative to apps/backend/ (or absolute).
TEMPLATE_SOURCE_DIR=../../packages/shared/src/templates/assets

# Frontend (for Vite dev proxy)
VITE_API_BASE_URL=http://localhost:3001
