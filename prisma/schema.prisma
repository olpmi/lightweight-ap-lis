generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums (wire strings preserved — schema identifiers match existing values)
// ---------------------------------------------------------------------------

enum Sex {
  Male
  Female
  Other
  Unknown

  @@map("sex")
}

enum AppLanguage {
  en
  fr
  ar
  ur
  sw

  @@map("app_language")
}

enum ReportType {
  final
  preliminary
  addendum
  revision

  @@map("report_type")
}

enum ReactivationType {
  revise
  addend

  @@map("reactivation_type")
}

enum ReportFileType {
  report_pdf
  prelim_pdf
  amended_pdf

  @@map("report_file_type")
}

model Doctor {
  doctorId  BigInt @id @default(autoincrement()) @map("doctor_id")
  lastName  String @map("last_name") @db.VarChar(100)
  firstName String @map("first_name") @db.VarChar(100)

  orders Order[]

  @@map("doctor")
}

model Patient {
  patientId   String   @id @map("patient_id") @db.VarChar(50)
  lastName    String   @map("last_name") @db.VarChar(100)
  firstName   String   @map("first_name") @db.VarChar(100)
  dateOfBirth DateTime @map("date_of_birth") @db.Date
  sex         Sex      @map("sex")

  orders Order[]

  @@map("patient")
}

model EmployeeRole {
  employeeRoleId Int    @id @default(autoincrement()) @map("employee_role_id")
  roleName       String @unique @map("role_name") @db.VarChar(30)

  employees Employee[]

  @@map("employee_role")
}

model Employee {
  employeeId      BigInt       @id @default(autoincrement()) @map("employee_id")
  lastName        String       @map("last_name") @db.VarChar(100)
  firstName       String       @map("first_name") @db.VarChar(100)
  userName        String       @unique @map("user_name") @db.VarChar(100)
  employeeRoleId  Int          @map("employee_role_id")
  employeeRole    EmployeeRole @relation(fields: [employeeRoleId], references: [employeeRoleId])
  defaultLanguage AppLanguage  @default(en) @map("default_language")

  reports         Report[]
  ancillaryOrders AncillaryOrder[]

  @@index([employeeRoleId])
  @@map("employee")
}

model BodySite {
  bodySiteId   Int     @id @default(autoincrement()) @map("body_site_id")
  bodySiteName String  @unique @map("body_site_name") @db.VarChar(255)
  description  String? @db.Text

  specimens Specimen[]

  @@map("body_site")
}

model SpecimenType {
  specimenTypeId   Int     @id @default(autoincrement()) @map("specimen_type_id")
  specimenTypeName String  @unique @map("specimen_type_name") @db.VarChar(255)
  description      String? @db.Text

  specimens Specimen[]

  @@map("specimen_type")
}

model ReportTemplate {
  reportTemplateId Int        @id @default(autoincrement()) @map("report_template_id")
  templateName     String     @unique @map("template_name") @db.VarChar(255)
  templateText     String?    @map("template_text") @db.Text
  isActive         Boolean    @default(true) @map("is_active")
  type             ReportType @default(final) @map("type")

  reports Report[]

  @@map("report_template")
}

/// Concurrency-safe sequence per year+prefix for order ID generation
model OrderSequenceYear {
  yearTwoDigit Int    @map("year_two_digit")
  prefix       String @map("prefix") @db.Char(2)
  lastValue    Int    @default(0) @map("last_value")

  @@id([yearTwoDigit, prefix])
  @@map("order_sequence_year")
}

model Order {
  orderId                 String    @id @map("order_id") @db.Char(11)
  patientId               String    @map("patient_id") @db.VarChar(50)
  doctorId                BigInt    @map("doctor_id")
  caseType                String?   @map("case_type") @db.VarChar(50)
  clinicalHistory         String?   @map("clinical_history") @db.Text
  registeredDate          DateTime  @map("registered_date")
  completedDate           DateTime? @map("completed_date")
  isReactivated           Boolean   @default(false) @map("is_reactivated")
  reactivatedFromReportId BigInt?   @map("reactivated_from_report_id")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  patient               Patient @relation(fields: [patientId], references: [patientId], onDelete: Restrict)
  doctor                Doctor  @relation(fields: [doctorId], references: [doctorId], onDelete: Restrict)
  reactivatedFromReport Report? @relation("OrderReactivation", fields: [reactivatedFromReportId], references: [reportId], onDelete: SetNull)

  specimens       Specimen[]
  reports         Report[]         @relation("OrderReports")
  ancillaryOrders AncillaryOrder[]

  @@index([patientId])
  @@index([doctorId])
  @@index([reactivatedFromReportId])
  @@index([registeredDate])
  @@map("orders")
}

model Specimen {
  specimenId       String   @id @map("specimen_id") @db.VarChar(20)
  orderId          String   @map("order_id") @db.Char(11)
  specimenCode     String   @map("specimen_code") @db.VarChar(10)
  bodySiteId       Int?     @map("body_site_id")
  specimenTypeId   Int?     @map("specimen_type_id")
  coldIschemicTime Int?     @map("cold_ischemic_time")
  updatedAt        DateTime @updatedAt @map("updated_at")

  order        Order         @relation(fields: [orderId], references: [orderId], onDelete: Cascade)
  bodySite     BodySite?     @relation(fields: [bodySiteId], references: [bodySiteId], onDelete: SetNull)
  specimenType SpecimenType? @relation(fields: [specimenTypeId], references: [specimenTypeId], onDelete: SetNull)

  blocks Block[]

  @@unique([orderId, specimenCode])
  @@index([bodySiteId])
  @@index([specimenTypeId])
  @@map("specimen")
}

model Block {
  blockId         String    @id @map("block_id") @db.VarChar(30)
  specimenId      String    @map("specimen_id") @db.VarChar(20)
  blockNumber     Int       @map("block_number")
  createdDatetime DateTime? @map("created_datetime")
  discarded       Boolean   @default(false) @map("discarded")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  specimen        Specimen         @relation(fields: [specimenId], references: [specimenId], onDelete: Cascade)
  slides          Slide[]
  ancillaryOrders AncillaryOrder[]

  @@unique([specimenId, blockNumber])
  @@map("block")
}

model Slide {
  slideId     String   @id @map("slide_id") @db.VarChar(40)
  blockId     String   @map("block_id") @db.VarChar(30)
  slideNumber Int      @map("slide_number")
  slideType   String?  @map("slide_type") @db.VarChar(50)
  discarded   Boolean  @default(false) @map("discarded")
  updatedAt   DateTime @updatedAt @map("updated_at")

  block Block @relation(fields: [blockId], references: [blockId], onDelete: Cascade)

  @@unique([blockId, slideNumber])
  @@map("slide")
}

model Report {
  reportId              BigInt            @id @default(autoincrement()) @map("report_id")
  orderId               String            @map("order_id") @db.Char(11)
  versionNumber         Int               @map("version_number")
  diagnosis             String?           @db.Text
  comment               String?           @db.Text
  reportTemplateId      Int?              @map("report_template_id")
  gross                 String?           @db.Text
  grossPayload          String?           @map("gross_payload") @db.Text
  synopticPayload       String?           @map("synoptic_payload") @db.Text
  pathologistEmployeeId BigInt?           @map("pathologist_employee_id")
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")
  signedOutDatetime     DateTime?         @map("signed_out_datetime")
  isFinal               Boolean           @default(false) @map("is_final")
  isPrelim              Boolean           @default(false) @map("is_prelim")
  reactivationType      ReactivationType? @map("reactivation_type")
  reactivationReason    String?           @map("reactivation_reason") @db.Text
  supersedesReportId    BigInt?           @map("supersedes_report_id")

  order               Order           @relation("OrderReports", fields: [orderId], references: [orderId], onDelete: Restrict)
  reportTemplate      ReportTemplate? @relation(fields: [reportTemplateId], references: [reportTemplateId], onDelete: SetNull)
  pathologist         Employee?       @relation(fields: [pathologistEmployeeId], references: [employeeId], onDelete: SetNull)
  supersedesReport    Report?         @relation("ReportVersioning", fields: [supersedesReportId], references: [reportId], onDelete: SetNull)
  supersededByReports Report[]        @relation("ReportVersioning")

  orderReactivations Order[]      @relation("OrderReactivation")
  reportFiles        ReportFile[]

  @@unique([orderId, versionNumber])
  @@index([reportTemplateId])
  @@index([pathologistEmployeeId])
  @@index([supersedesReportId])
  // Supports the "is this order signed out?" filter used by every queue
  // (`reports: { none: { isFinal: true, signedOutDatetime: { not: null } } }`).
  @@index([orderId, isFinal, signedOutDatetime])
  @@map("report")
}

model ReportFile {
  reportFileId     BigInt         @id @default(autoincrement()) @map("report_file_id")
  reportId         BigInt         @map("report_id")
  fileType         ReportFileType @map("file_type")
  fileName         String?        @map("file_name") @db.VarChar(255)
  originalFileName String?        @map("original_file_name") @db.VarChar(255)
  mimeType         String         @default("application/pdf") @map("mime_type") @db.VarChar(100)
  storagePath      String?        @map("storage_path") @db.VarChar(500)
  createdAt        DateTime       @default(now()) @map("created_at")

  report Report @relation(fields: [reportId], references: [reportId], onDelete: Cascade)

  @@index([reportId, fileType, createdAt])
  @@map("report_file")
}

model CustomTemplate {
  id          String   @id @default(cuid()) @map("id")
  templateKey String   @unique @map("template_key") @db.VarChar(500)
  family      String   @map("family") @db.VarChar(100)
  kind        String   @map("kind") @db.VarChar(20)
  schemaStyle String   @map("schema_style") @db.VarChar(20)
  title       String   @map("title") @db.VarChar(500)
  coreJson    Json     @map("core_json")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  translations CustomTemplateTranslation[]

  @@map("custom_template")
}

model CustomTemplateTranslation {
  id              String   @id @default(cuid()) @map("id")
  templateKey     String   @map("template_key") @db.VarChar(500)
  languageCode    String   @map("language_code") @db.VarChar(10)
  translationJson Json     @map("translation_json")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  template CustomTemplate @relation(fields: [templateKey], references: [templateKey], onDelete: Cascade)

  @@unique([templateKey, languageCode])
  @@map("custom_template_translation")
}

/// PDF report layout template (HTML/Handlebars) for a report type
model ReportLayout {
  reportLayoutId Int        @id @default(autoincrement()) @map("report_layout_id")
  reportType     ReportType @unique @map("report_type")
  name           String     @map("name") @db.VarChar(255)
  htmlTemplate   String     @map("html_template") @db.Text
  isActive       Boolean    @default(true) @map("is_active")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  @@map("report_layout")
}

// ---------------------------------------------------------------------------
// Ancillary Testing
// ---------------------------------------------------------------------------

enum AncillaryCategory {
  HE_LEVELS
  IHC
  SPECIAL_STAIN
  MOLECULAR
  SEND_OUT
  HE

  @@map("ancillary_category")
}

enum AncillaryOrderStatus {
  PULL_BLOCK
  MICROTOMY
  SLIDE_STAIN
  DISTRIBUTED
  CANCELLED
  PULL_MATERIAL
  MATERIAL_SENT
  MATERIAL_RETURNED

  @@map("ancillary_order_status")
}

/// Catalog of individual orderable ancillary tests
model AncillaryOrderable {
  id        Int               @id @default(autoincrement())
  name      String            @db.VarChar(200)
  category  AncillaryCategory
  isActive  Boolean           @default(true) @map("is_active")
  sortOrder Int               @default(0) @map("sort_order")

  panelItems AncillaryPanelItem[]
  orders     AncillaryOrder[]

  @@unique([name, category])
  @@map("ancillary_orderable")
}

/// Named panel grouping multiple orderables
model AncillaryPanel {
  id        Int               @id @default(autoincrement())
  name      String            @db.VarChar(200)
  category  AncillaryCategory
  isActive  Boolean           @default(true) @map("is_active")
  sortOrder Int               @default(0) @map("sort_order")

  items AncillaryPanelItem[]

  @@unique([name, category])
  @@map("ancillary_panel")
}

/// Join table: panel ↔ orderable
model AncillaryPanelItem {
  panelId     Int @map("panel_id")
  orderableId Int @map("orderable_id")

  panel     AncillaryPanel     @relation(fields: [panelId], references: [id], onDelete: Cascade)
  orderable AncillaryOrderable @relation(fields: [orderableId], references: [id], onDelete: Cascade)

  @@id([panelId, orderableId])
  @@index([orderableId])
  @@map("ancillary_panel_item")
}

/// A single placed ancillary test request, tied to a block on a case
model AncillaryOrder {
  id           Int                  @id @default(autoincrement())
  orderId      String               @map("order_id") @db.Char(11)
  blockId      String               @map("block_id") @db.VarChar(30)
  orderableId  Int                  @map("orderable_id")
  status       AncillaryOrderStatus @default(PULL_BLOCK)
  levelCount   Int?                 @map("level_count")
  notes        String?              @db.Text
  resultNotes  String?              @map("result_notes") @db.Text
  orderedAt    DateTime             @default(now()) @map("ordered_at")
  inProgressAt DateTime?            @map("in_progress_at")
  completedAt  DateTime?            @map("completed_at")
  cancelledAt  DateTime?            @map("cancelled_at")
  orderedById  BigInt?              @map("ordered_by_id")
  updatedAt    DateTime             @updatedAt @map("updated_at")

  order     Order              @relation(fields: [orderId], references: [orderId], onDelete: Cascade)
  block     Block              @relation(fields: [blockId], references: [blockId], onDelete: Cascade)
  orderable AncillaryOrderable @relation(fields: [orderableId], references: [id], onDelete: Restrict)
  orderedBy Employee?          @relation(fields: [orderedById], references: [employeeId], onDelete: SetNull)

  @@index([orderId])
  @@index([blockId])
  @@index([orderableId])
  @@index([orderedById])
  @@index([status, orderedAt])
  @@map("ancillary_order")
}
