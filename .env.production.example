# Production environment example
# Copy to .env.production and fill in real values. NEVER commit the real file.
#
# Usage:
#   docker compose --env-file .env.production -f docker-compose.prod.yml up -d --build
#
# Optional GCS backup (requires --profile backup):
#   Set WALG_GCS_PREFIX below, then:
#   mkdir -p secrets && cp /path/to/gcp-sa.json secrets/gcp-sa.json
#   chmod 644 secrets/gcp-sa.json   # must be readable by uid 70 (postgres container user)
#   docker compose --env-file .env.production -f docker-compose.prod.yml \
#     --profile backup up -d --build

# ─── Application ──────────────────────────────────────────────────────────
SESSION_SECRET=change-me-use-a-long-random-string-min-32-chars
# Set to true only when the app is served over HTTPS (TLS termination at nginx or a load balancer).
# Leave false (or unset) when running over plain HTTP — browsers drop Secure cookies on HTTP.
COOKIE_SECURE=false
NODE_ENV=production
PORT=3001

# Public origin allowed by backend CORS (the URL your frontend is served from).
CORS_ORIGIN=https://your-domain.example.com

# Storage path for generated PDF files (relative to apps/backend).
STORAGE_PATH=./storage

# ─── PostgreSQL ───────────────────────────────────────────────────────────
# Credentials for the primary PostgreSQL server.
POSTGRES_USER=lis_user
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=lis_db

# Password for the internal streaming-replication user (replicator).
# Must differ from POSTGRES_PASSWORD.
REPLICATION_PASSWORD=change-me-strong-replication-password

# Connection URLs used by the backend.
# DATABASE_URL     → primary (all writes + default reads).
# DATABASE_URL_REPLICA → standby (optional; routes read-heavy queries to the
#                        hot standby). Remove or leave empty to disable.
DATABASE_URL=postgresql://lis_user:change-me-strong-password@postgres_primary:5432/lis_db
DATABASE_URL_REPLICA=postgresql://lis_user:change-me-strong-password@postgres_standby:5432/lis_db

# ─── GCS Backup (optional — leave WALG_GCS_PREFIX empty to disable) ──────
# Full GCS URI prefix for WAL archiving and base backups.
# Example: gs://your-bucket/postgres-backups
# When empty, WAL segments are archived to the local wal_archive Docker volume
# only (useful for gap recovery; no off-site base backups).
WALG_GCS_PREFIX=

# Compression algorithm for wal-g uploads.
# Options: lz4 (fast, recommended), zstd, brotli, snappy, none
WALG_COMPRESSION_METHOD=lz4

# Path inside containers to the GCP service-account JSON key file.
# The file is bind-mounted from ./secrets/gcp-sa.json (see docker-compose.prod.yml).
# Required only when WALG_GCS_PREFIX is set.
GOOGLE_APPLICATION_CREDENTIALS=/secrets/gcp-sa.json
