# Production environment example
# Copy to .env.production and fill in real values. NEVER commit the real file.
#
# Database is reached via the Cloud SQL Auth Proxy sidecar defined in
# docker-compose.prod.yml. The hostname `cloudsql-proxy` is the compose
# service name; the proxy itself terminates the IAM-authenticated tunnel
# to your Cloud SQL instance.

# ─── Application ──────────────────────────────────────────────────────────
DATABASE_URL=postgresql://<DB_USER>:<DB_PASSWORD>@cloudsql-proxy:5432/<DB_NAME>
SESSION_SECRET=<set-a-long-random-string>
NODE_ENV=production
PORT=3001

# Public origin allowed by backend CORS (the URL your frontend is served from)
CORS_ORIGIN=https://your-domain.example.com

# Storage paths (relative to apps/backend)
STORAGE_PATH=./storage

# ─── Frontend ─────────────────────────────────────────────────────────────
# The frontend bundle uses a relative `/api` baseURL served by nginx, so no
# build-time API URL is required. (Override only if you split the frontend
# onto a different origin from the backend.)

# ─── Cloud SQL Auth Proxy ─────────────────────────────────────────────────
# Format: <project-id>:<region>:<instance-name>
INSTANCE_CONNECTION_NAME=your-gcp-project:us-central1:your-instance

# Path inside the cloudsql-proxy container to a Google service-account JSON
# key with role roles/cloudsql.client. The host file is bind-mounted via
# docker-compose.prod.yml at ./secrets/gcp-sa.json.
GOOGLE_APPLICATION_CREDENTIALS=/secrets/gcp-sa.json
