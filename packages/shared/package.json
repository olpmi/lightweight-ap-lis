{
  "name": "@lis/shared",
  "version": "1.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./patient-summaries/server": {
      "import": "./dist/patientSummaries/server.js",
      "require": "./dist/patientSummaries/server.js",
      "types": "./dist/patientSummaries/server.d.ts"
    },
    "./templates/server": {
      "import": "./dist/templates/server.js",
      "require": "./dist/templates/server.js",
      "types": "./dist/templates/server.d.ts"
    }
  },
  "scripts": {
    "build": "tsc && node ./scripts/copy-templates.mjs",
    "typecheck": "tsc --noEmit",
    "audit:templates": "node ./scripts/audit-templates.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "typescript": "*"
  },
  "dependencies": {
    "zod": "^3.22.0"
  }
}
