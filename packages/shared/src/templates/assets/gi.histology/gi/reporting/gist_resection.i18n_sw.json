            "pt1_tumor_2cm_or_less": "pT1: Uvimbe cm 2 au chini",
            "pt2_tumor_gt2cm_le5cm": "pT2: Uvimbe zaidi ya cm 2 lakini si zaidi ya cm 5",
            "pt3_tumor_gt5cm_le10cm": "pT3: Uvimbe zaidi ya cm 5 lakini si zaidi ya cm 10",
            "pt4_tumor_gt10cm": "pT4: Uvimbe zaidi ya cm 10 katika kipimo kikubwa zaidi"
