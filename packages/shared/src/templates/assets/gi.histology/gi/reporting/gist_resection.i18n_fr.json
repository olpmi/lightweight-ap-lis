    "ptnm": {
      "title": "CLASSIFICATION pTNM (AJCC 8e édition)",
      "description": "La déclaration des catégories pT, pN et, le cas échéant, pM est basée sur les informations disponibles pour le pathologiste au moment de l’émission du rapport. Selon l’AJCC (chapitre 1, 8e éd.), il incombe au médecin responsable d’établir le stade pathologique final à partir de toutes les informations pertinentes, y compris, sans s’y limiter, ce rapport d’anatomopathologie.",
      "fields": {
        "modified_classification": {
          "label": "Classification modifiée (requise seulement le cas échéant) (sélectionner tout ce qui s’applique)",
          "options": {
            "not_applicable": "Sans objet",
            "y_post_neoadjuvant_therapy": "y (après traitement néoadjuvant)",
            "r_recurrence": "r (récidive)"
          }
        },
        "pt_category": {
          "label": "Catégorie pT",
          "options": {
            "pt_not_assigned_cannot_be_determined": "pT non attribué (ne peut être déterminé selon les informations pathologiques disponibles)",
            "pt0_no_evidence_primary_tumor": "pT0 : aucune preuve de tumeur primaire",
            "pt1_tumor_2cm_or_less": "pT1 : tumeur de 2 cm ou moins",
            "pt2_tumor_gt2cm_le5cm": "pT2 : tumeur de plus de 2 cm mais pas plus de 5 cm",
            "pt3_tumor_gt5cm_le10cm": "pT3 : tumeur de plus de 5 cm mais pas plus de 10 cm",
            "pt4_tumor_gt10cm": "pT4 : tumeur de plus de 10 cm dans sa plus grande dimension"
          }
        },
        "t_suffix": {
          "label": "Suffixe T (requis seulement le cas échéant)",
          "options": {
            "not_applicable": "Sans objet",
            "m_multiple_primary_synchronous_tumors": "(m) Tumeurs primaires synchrones multiples dans un seul organe"
          }
        },
        "pn_category": {
          "label": "Catégorie pN",
          "note": "Lorsqu’aucun ganglion lymphatique n’est présent (comme c’est souvent le cas pour une résection de GIST), la catégorie pathologique « N » n’est pas attribuée (pNX n’est pas utilisé pour les GIST) et ne doit pas être rapportée.",
          "options": {
            "pn_not_assigned_no_nodes": "pN non attribué (aucun ganglion soumis ou trouvé)",
            "pn_not_assigned_cannot_be_determined": "pN non attribué (ne peut être déterminé selon les informations pathologiques disponibles)",
            "pn0_no_regional_lymph_node_metastasis": "pN0 : aucune métastase ganglionnaire régionale",
            "pn1_regional_lymph_node_metastasis": "pN1 : métastase ganglionnaire régionale"
          }
