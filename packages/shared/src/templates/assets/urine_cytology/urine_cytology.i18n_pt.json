      "fields": [
        {
          "id": "cytologic_features",
          "label": "Características citológicas observadas",
          "type": "multiselect",
          "options": [
            "Aumento da relação núcleo/citoplasma",
            "Hipercromasia nuclear",
            "Irregularidade da membrana nuclear",
            "Cromatina grosseira ou agregada",
            "Pleomorfismo celular",
            "Nucléolos proeminentes",
            "Necrose",
            "Figuras de mitose",
            "Agrupamentos celulares tridimensionais",
            "Outro"
          ]
        },
        {
          "id": "cytologic_features_other",
          "label": "Outra característica citológica",
          "type": "text"
        }
      ]
    },
    {
      "id": "microscopic_description",
      "title": "Descrição microscópica",
      "fields": [
        {
          "id": "microscopic_description_text",
          "label": "Descrição microscópica",
          "type": "textarea"
        }
      ]
    },
    {
      "id": "malignancy_subtype",
      "title": "Em caso de malignidade ou outra neoplasia maligna, favorecer",
      "fields": [
        {
          "id": "malignancy_favor",
          "label": "Favorecer diagnóstico de",
          "type": "multiselect",
          "options": [
            "Carcinoma urotelial de alto grau",
            "Carcinoma urotelial com diferenciação escamosa",
            "Carcinoma urotelial com diferenciação glandular",
            "Carcinoma de células escamosas",
            "Adenocarcinoma",
            "Carcinoma de pequenas células / neoplasia neuroendócrina",
            "Carcinoma metastático",
            "Neoplasia hematolinfoide",
            "Outro"
          ]
        },
        {
          "id": "malignancy_favor_other",
          "label": "Outra neoplasia maligna",
          "type": "text"
        }
      ]
    },
    {
