      "fields": [
        {
          "id": "negative_findings_options",
          "label": "Achados",
          "type": "multiselect",
          "options": [
            "Células uroteliais benignas",
            "Células uroteliais reativas",
            "Alterações degenerativas",
            "Inflamação",
            "Cristais",
            "Alterações associadas a cálculos",
            "Efeito citopático por poliomavírus",
