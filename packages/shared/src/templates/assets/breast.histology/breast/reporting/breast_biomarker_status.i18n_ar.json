  "her2_ihc_status": {
    "label": "حالة HER2 بالتلوين المناعي الكيميائي (IHC)",
    "comment": "قد تكون سرطانات الثدي ذات درجات HER2 IHC البالغة 0+ أو 1+ أو 2+ (مع ISH سلبي) مؤهلة للعلاج الذي يستهدف مستويات غير متضخمة من تعبير HER2 في سياق المرض النقائلي. حاليًا، المرضى الذين لا يظهر لديهم تلوين غشائي في IHC (0) غير مؤهلين أو مستبعدين. يُنظر في استخدام التعليق الاختياري المعياري لتقرير HER2 IHC لشرح الأهمية السريرية للمستويات المنخفضة من تلوين HER2 IHC في سياق المرض النقائلي وتعريفات HER2 المنخفض جدًا والمنخفض المستخدمة في التجارب السريرية.",
    "fields": {
      "overall_score": {
        "label": "الدرجة الإجمالية لـ HER2 IHC",
        "options": [
          "سلبي (الدرجة 0)",
          "سلبي (الدرجة 1+)",
          "غير حاسم (الدرجة 2+)",
          "إيجابي (الدرجة 3+)"
        ],
        "type": "select",
        "value": ""
      },
      "score_0_pattern": {
        "label": "نمط الدرجة 0",
        "options": [
          "لم يُكتشف أي تلوين غشائي (0 / غياب التلوين الغشائي)",
          "تلوين غشائي غير مكتمل وخافت أو بالكاد يُدرك، وفي 10% أو أقل من الخلايا الورمية (0+ / مع تلوين غشائي)",
          "أخرى"
        ],
        "other_specify": "",
        "type": "select",
        "value": ""
      },
      "score_1_pattern": {
        "label": "نمط الدرجة 1+",
        "options": [
          "تلوين غشائي غير مكتمل وخافت أو بالكاد يُدرك، وفي أكثر من 10% من الخلايا الورمية",
          "أخرى"
        ],
        "other_specify": "",
        "type": "select",
        "value": ""
      },
      "score_2_pattern": {
        "label": "نمط الدرجة 2+",
        "options": [
          "تلوين غشائي كامل ضعيف إلى متوسط يُلاحظ في أكثر من 10% من الخلايا الورمية",
          "تلوين غشائي غير مكتمل متوسط إلى شديد (قاعدي جانبي)",
          "10% أو أقل من السرطان يُظهر تلوينًا محيطيًا كاملًا وشديدًا (3+) (غير متجانس لكنه محدود جدًا؛ تؤخذ نتائج عينات إضافية في الاعتبار)",
          "وجود تلوين سيتوبلازمي غزير يحجب تقييم شدة التلوين الغشائي",
          "أخرى"
        ],
        "other_specify": "",
        "type": "select",
        "value": ""
      },
      "score_3_pattern": {
        "label": "نمط الدرجة 3+",
        "options": ["تلوين غشائي محيطي كامل وشديد وفي أكثر من 10% من الخلايا الورمية", "أخرى"],
        "other_specify": "",
        "type": "select",
        "value": ""
      }
    }
  },
