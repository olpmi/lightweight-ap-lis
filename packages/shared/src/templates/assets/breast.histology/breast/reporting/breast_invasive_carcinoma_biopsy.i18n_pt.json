            "value": "",
            "cannot_be_determined_specify": {
              "label": "Não pode ser determinado (especificar)",
              "type": "text",
              "value": ""
            },
            "reference_note": "Ver Tabela 1 no Protocolo CAP."
          },
          "overall_grade": {
            "label": "Grau geral",
            "type": "select",
            "options": [
              "Grau 1 (pontuações 3, 4 ou 5)",
              "Grau 2 (pontuações 6 ou 7)",
              "Grau 3 (pontuações 8 ou 9)",
              "Pontuação não pode ser determinada"
            ],
            "value": "",
            "cannot_be_determined_specify": {
              "label": "Não pode ser determinado (especificar)",
              "type": "text",
              "value": ""
            }
          }
