      "histologic_grade": {
        "label": "Grau histológico (Pontuação Histológica de Nottingham)",
        "fields": {
          "applicability": {
            "label": "Aplicabilidade",
            "type": "select",
            "options": [
              "Não aplicável (sem carcinoma residual ou apenas microinvasão)",
              "Pontuação de Nottingham"
            ],
            "value": ""
          },
          "glandular_tubular_differentiation": {
            "label": "Diferenciação glandular (acinar) / tubular",
            "type": "select",
            "options": [
              "Pontuação 1 (mais de 75% da área tumoral com formação de estruturas glandulares / tubulares)",
              "Pontuação 2 (10% a 75% da área tumoral com formação de estruturas glandulares / tubulares)",
              "Pontuação 3 (menos de 10% da área tumoral com formação de estruturas glandulares / tubulares)",
              "Pontuação não pode ser determinada"
            ],
            "value": "",
            "cannot_be_determined_specify": {
              "label": "Não pode ser determinado (especificar)",
              "type": "text",
              "value": ""
            }
          },
          "nuclear_pleomorphism": {
            "label": "Pleomorfismo nuclear",
            "type": "select",
            "options": [
              "Pontuação 1 (núcleos pequenos com pouco aumento de tamanho em comparação com células epiteliais mamárias normais, contornos regulares, cromatina nuclear uniforme, pouca variação de tamanho)",
              "Pontuação 2 (células maiores que o normal com núcleos vesiculares abertos, nucléolos visíveis e variabilidade moderada no tamanho e forma)",
              "Pontuação 3 (núcleos vesiculares, frequentemente com nucléolos proeminentes, apresentando acentuada variação no tamanho e forma, ocasionalmente com formas muito grandes e bizarras)",
              "Pontuação não pode ser determinada"
            ],
            "value": "",
            "cannot_be_determined_specify": {
              "label": "Não pode ser determinado (especificar)",
              "type": "text",
              "value": ""
