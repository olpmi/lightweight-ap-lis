  "pathologic_stage": {
    "label": "Classificação do estadiamento patológico (pTNM, AJCC 8ª Edição)",
    "note": "A notificação das categorias pT, pN e, quando aplicável, pM baseia-se nas informações disponíveis para o patologista no momento da emissão do relatório.",
    "fields": {
      "tnm_descriptors": {
        "label": "Descritores TNM",
        "type": "select",
        "options": ["Não aplicável", "r (recidiva)"],
        "value": ""
      },
      "pT_category": {
        "label": "Categoria pT",
        "type": "select",
        "options": [
          "pTis (CDIS): Carcinoma ductal in situ",
          "pTis (Paget): Doença de Paget do mamilo NÃO associada a carcinoma invasivo e/ou CDIS no parênquima mamário subjacente"
        ],
        "value": ""
      },
      "regional_lymph_nodes_modifier": {
        "label": "Modificador dos gânglios linfáticos regionais",
        "type": "multi_select",
        "options": [
          "Não aplicável",
          "(sn): Gânglio(s) linfático(s) sentinela avaliado(s)",
          "(f): Metástase nodal confirmada por punção aspirativa por agulha fina ou biópsia por agulha grossa"
        ],
        "value": []
      },
      "pN_category": {
        "label": "Categoria pN",
        "type": "select",
        "options": [
          "pN não atribuído (nenhum gânglio linfático submetido ou encontrado)",
          "pN não atribuído (não pode ser determinado com base nas informações patológicas disponíveis)",
          "pN0: Nenhuma metástase em gânglio linfático regional identificada ou apenas CTIs",
          "pN0 (i+): Apenas CTIs em gânglio(s) linfático(s) regional(is)",
          "pN0 (mol+): Achados moleculares positivos por RT-PCR; nenhuma CTI detectada",
          "pN1mi: Micrometástases",
          "pN1a: Metástases em 1-3 gânglios linfáticos axilares, pelo menos uma metástase maior que 2,0 mm",
          "pN1b: Metástases em gânglios linfáticos sentinela da cadeia mamária interna ipsilateral, excluindo CTIs",
          "pN1c: pN1a e pN1b combinados",
          "pN2a: Metástases em 4-9 gânglios linfáticos axilares, pelo menos um depósito tumoral maior que 2,0 mm",
          "pN2b: Metástases em gânglios linfáticos da mamária interna detectados clinicamente com gânglios linfáticos axilares negativos ao exame patológico",
          "pN3a: Metástases em 10 ou mais gânglios linfáticos axilares ou metástases em gânglios linfáticos infraclaviculares",
          "pN3b: pN1a ou pN2a na presença de cN2b, ou pN2a na presença de pN1b",
          "pN3c: Metástases em gânglios linfáticos supraclaviculares ipsilaterais"
        ],
        "value": ""
      },
      "pM_category": {
        "label": "Categoria pM",
        "type": "select",
        "options": [
          "Não aplicável — pM não pode ser determinado a partir da(s) espécime(s) submetida(s)",
          "pM1: Metástases comprovadas histologicamente maiores que 0,2 mm"
        ],
        "value": ""
