        ],
        "type": "multi_select",
        "value": []
      },
      "pN_category": {
        "label": "Catégorie pN",
        "options": [
          "pN non attribué (aucun ganglion soumis ou trouvé)",
          "pN non attribué (ne peut pas être déterminé sur la base des informations pathologiques disponibles)",
          "pN0 : aucune métastase ganglionnaire régionale ou CTI uniquement",
          "pN0 (i+) : CTI uniquement dans les ganglions lymphatiques régionaux",
          "pN0 (mol+) : résultats moléculaires positifs par RT-PCR ; aucune CTI détectée",
          "pN1mi : micrométastases",
          "pN1a : métastases dans 1 à 3 ganglions axillaires, au moins une métastase > 2,0 mm",
          "pN1b : métastases dans les ganglions sentinelles mammaires internes ipsilatéraux, à l'exclusion des CTI",
          "pN1c : pN1a et pN1b combinés",
          "pN2a : métastases dans 4 à 9 ganglions axillaires, au moins un dépôt tumoral > 2,0 mm",
          "pN2b : métastases dans les ganglions mammaires internes détectés cliniquement avec des ganglions axillaires pathologiquement négatifs",
          "pN3a : métastases dans 10 ganglions axillaires ou plus, ou métastases dans les ganglions sous-claviculaires",
          "pN3b : pN1a ou pN2a en présence de cN2b, ou pN2a en présence de pN1b",
          "pN3c : métastases dans les ganglions sus-claviculaires ipsilatéraux"
        ],
        "type": "select",
        "value": ""
      },
      "pM_category": {
        "label": "Catégorie pM",
        "options": [
