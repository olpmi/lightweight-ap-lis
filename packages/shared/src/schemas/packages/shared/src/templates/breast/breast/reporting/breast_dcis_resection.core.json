  "pathologic_stage": {
    "label": "Pathologic Stage Classification (pTNM, AJCC 8th Edition)",
    "note": "Reporting of pT, pN, and when applicable pM categories is based on information available to the pathologist at the time the report is issued.",
    "fields": {
      "tnm_descriptors": {
        "label": "TNM descriptors",
        "type": "select",
        "options": ["Not applicable", "r (recurrent)"],
        "value": ""
      },
      "pT_category": {
        "label": "pT category",
        "type": "select",
        "options": [
          "pTis (DCIS): Ductal carcinoma in situ",
          "pTis (Paget): Paget disease of the nipple NOT associated with invasive carcinoma and / or DCIS in the underlying breast parenchyma"
        ],
        "value": ""
      },
      "regional_lymph_nodes_modifier": {
        "label": "Regional lymph nodes modifier",
        "type": "multi_select",
        "options": [
          "Not applicable",
          "(sn): Sentinel node(s) evaluated",
          "(f): Nodal metastasis confirmed by fine needle aspiration or core needle biopsy"
        ],
        "value": []
      },
      "pN_category": {
        "label": "pN category",
        "type": "select",
        "options": [
          "pN not assigned (no nodes submitted or found)",
          "pN not assigned (cannot be determined based on available pathological information)",
          "pN0: No regional lymph node metastasis identified or ITCs only",
          "pN0 (i+): ITCs only in regional lymph node(s)",
          "pN0 (mol+): Positive molecular findings by RT-PCR; no ITCs detected",
          "pN1mi: Micrometastases",
          "pN1a: Metastases in 1-3 axillary lymph nodes, at least one metastasis larger than 2.0 mm",
          "pN1b: Metastases in ipsilateral internal mammary sentinel nodes, excluding ITCs",
          "pN1c: pN1a and pN1b combined",
          "pN2a: Metastases in 4-9 axillary lymph nodes, at least one tumor deposit larger than 2.0 mm",
          "pN2b: Metastases in clinically detected internal mammary lymph nodes with pathologically negative axillary nodes",
          "pN3a: Metastases in 10 or more axillary lymph nodes or metastases to infraclavicular nodes",
          "pN3b: pN1a or pN2a in the presence of cN2b, or pN2a in the presence of pN1b",
          "pN3c: Metastases in ipsilateral supraclavicular lymph nodes"
        ],
        "value": ""
