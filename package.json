{
  "name": "lightweight-ap-lis",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev:backend": "pnpm --filter @lis/backend dev",
    "dev:frontend": "pnpm --filter @lis/frontend dev",
    "build": "pnpm -r build",
    "test": "pnpm -r --if-present test",
    "test:backend": "pnpm --filter @lis/backend test",
    "test:frontend": "pnpm --filter @lis/frontend test",
    "test:e2e": "pnpm --filter @lis/frontend test:e2e",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "db:migrate": "prisma migrate dev --schema=prisma/schema.prisma",
    "db:migrate:deploy": "prisma migrate deploy --schema=prisma/schema.prisma",
    "db:generate": "prisma generate --schema=prisma/schema.prisma",
    "db:seed": "tsx prisma/seed.ts",
    "db:characterize": "tsx scripts/dataset-characteristics.ts",
    "metrics:system": "tsx scripts/system-characteristics.ts",
    "metrics:deployment": "tsx scripts/deployment-profile.ts",
    "verify:report": "tsx scripts/verification-report.ts",
    "bench": "tsx scripts/benchmark.ts",
    "db:studio": "prisma studio --schema=prisma/schema.prisma",
    "db:reset": "prisma migrate reset --schema=prisma/schema.prisma",
    "figures:manuscript": "pnpm --filter @lis/frontend exec playwright test --config=playwright.figures.config.ts",
    "figures:compose": "tsx scripts/build-manuscript-figures.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@prisma/client": "^5.13.0",
    "dotenv": "^16.4.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.3.0",
    "prisma": "^5.13.0",
    "tsx": "^4.23.12",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
